# ── Required for every environment ─────────────────────────────────────────

# AWS: the base identity that's allowed to assume AWS_ROLE_ARN (see aws/credentials_manager.py).
# Local dev: put these in .env. Production (Cloud Run): set as Secret Manager secrets, not plaintext env vars.
AWS_ACCESS_KEY_ID="your-iam-user-access-key"
AWS_SECRET_ACCESS_KEY="your-iam-user-secret-key"
AWS_ROLE_ARN="arn:aws:iam::<account-id>:role/TerraForgeRole"
AWS_EXTERNAL_ID="generated-automatically-on-first-run-if-unset"

# Google Cloud Vertex AI (Gemini). Uses Application Default Credentials, not an API key.
# - Local dev: run `gcloud auth application-default login` once, or set GOOGLE_APPLICATION_CREDENTIALS
#   to a service account JSON key path.
# - Cloud Run: if deployed in the SAME project as below, no credentials file is needed at all —
#   grant the Cloud Run service's runtime service account the "Vertex AI User" IAM role instead.
GOOGLE_CLOUD_PROJECT="sre-agent-project-505914"
GOOGLE_CLOUD_LOCATION="us-central1"

# ── Required only in production (Cloud Run / anywhere without durable local disk) ──

# Supabase (or any Postgres) connection string. When set, job history and LangGraph
# checkpoints both move from local SQLite files to this database. Use Supabase's
# connection-pooling URL (port 6543, "Transaction" mode), not the direct port 5432
# one — the app opens a short-lived connection per request and the pooler avoids
# exhausting Supabase's free-tier connection limit.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Comma-separated list of extra allowed CORS origins beyond localhost, e.g. your
# Vercel deployment URL(s).
# FRONTEND_ORIGINS="https://your-app.vercel.app"

# ── Optional ────────────────────────────────────────────────────────────────

# LangSmith tracing (nice for debugging pipeline runs, not required to run the app)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="RAG-based-IAC"

# Shared Terraform provider plugin cache (defaults to ~/.terraform.d/plugin-cache if unset)
# TF_PLUGIN_CACHE_DIR="/app/.terraform-plugin-cache"
